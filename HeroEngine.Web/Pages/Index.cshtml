@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome to Bytecroft";
}

<div class="text-center">
    <h1 class="display-4">Welcome to HeroEngine Web</h1>

    <div class="row mt-5 justify-content-center">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Active Heroes</h5>
                <p class="card-text display-6">@Model.RegisteredHeroesCount</p>
                <a asp-page="/Heroes/List" class="btn btn-light mt-2">View Heroes List</a>
            </div>
        </div>
    </div>
</div>
